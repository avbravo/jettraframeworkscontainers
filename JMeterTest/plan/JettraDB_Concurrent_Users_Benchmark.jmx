      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="tearDown - Drop Ephemeral Benchmark Database (${DATABASE})" enabled="true">
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
