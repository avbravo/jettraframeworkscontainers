    <artifactId>JettraReport</artifactId>
    <packaging>jar</packaging>
    <name>JettraReport</name>
    <description>Módulo JettraReport para el ecosistema Jettra</description>

    <dependencies>
        <dependency>
            <groupId>io.jettra</groupId>
            <artifactId>JettraFlux</artifactId>
            <!--<version>${jettra.flux.version}</version>-->
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
